{
  "hooks": {
    // user's prior hooks
    "Stop": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "echo done" } ] },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holt hook Stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holt hook PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holt hook PostToolUse"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holt hook Notification"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holt hook SessionStart"
          }
        ]
      }
    ]
  }
}
